+/*
+ * Band processing (AG Projects, python3-sipsimple patch 09_aec).
+ *
+ * The (pre-AEC3) WebRTC AEC core only runs at 8 or 16 kHz.  For "super
+ * wideband" input the core must be given the 0-8 kHz band (160 samples per
+ * 10 ms, 16 kHz rate) plus the upper band(s), split with the QMF filter
+ * bank, exactly as webrtc::AudioProcessing does.  When initialized with
+ * sampFreq 32000 the core expects num_bands == 2.
+ *
+ * Upstream pjsip feeds 160 *full band* samples (5 ms at 32 kHz) with
+ * num_bands == 1 instead (pjsip issue #2404, closed as wontfix).  The core
+ * then treats 32 kHz audio as if it were 16 kHz: the adaptive filter covers
+ * half the intended echo path, the delay estimator range is halved and
+ * convergence is several times slower.  The mismatch trips an assert in
+ * aec_core.c, which is only silent because release builds use -DNDEBUG.
+ *
+ * This file therefore:
+ *  - processes 10 ms blocks at the core rate,
+ *  - at 32 kHz splits near and far end into low/high bands with
+ *    WebRtcSpl_AnalysisQMF() and recombines with WebRtcSpl_SynthesisQMF(),
+ *  - at any other rate that the core can't take natively (48 kHz, 44.1 kHz,
+ *    ...) resamples near and far end to the closest core rate (32 kHz for
+ *    rates above 16 kHz) and back.  The audio above 16 kHz on the
+ *    microphone path is lost in that case, which is irrelevant for voice.
+ *
+ *  - runs the capture signal through the same 2nd order high pass filter
+ *    (~80 Hz) that webrtc::AudioProcessing applies before the AEC, as the
+ *    original AG Projects wrapper (echo_webrtc_aec.c, 2013) did.  DC offset
+ *    and rumble below what laptop speakers can reproduce otherwise disturb
+ *    the adaptive filter.
+ *
+ * The mobile (AECM) path is unchanged.
+ */
+#define MAX_BAND_LEN            160     /* 10 ms at 16 kHz                  */
+#define MAX_PROC_LEN            320     /* 10 ms at 32 kHz                  */
+
+/* Statistics (desktop path): the WebRTC metric functions update internal
+ * state (UpdateDelayMetrics() clears the delay histogram), so they must not
+ * be called from the application thread while the capture thread runs the
+ * canceller.  The capture thread takes a snapshot every STAT_INTERVAL_BLOCKS
+ * 10 ms blocks; webrtc_aec_get_stat() copies the snapshot under a sequence
+ * counter (seqlock) and never touches the WebRTC instance.
+ */
+#define STAT_INTERVAL_BLOCKS    100     /* 1 s                              */
+#define AEC_LEVEL_UNAVAILABLE   -100    /* kOffsetLevel in echo_cancellation.c */
+
+#if !PJMEDIA_WEBRTC_AEC_USE_MOBILE
+/* High pass filter, from webrtc/modules/audio_processing/high_pass_filter_impl
+ * (same code as the 2013 AG Projects echo_webrtc_aec.c). Q12 fixed point.
+ */
+static const int16_t kHpfCoefficients8kHz[5] = {3798, -7596, 3798, 7807, -3733};
+static const int16_t kHpfCoefficients[5]     = {4012, -8024, 4012, 8002, -3913};
+
+typedef struct hpf_state
+{
+    int16_t        y[4];
+    int16_t        x[2];
+    const int16_t *ba;
+} hpf_state;
+
+static void hpf_init(hpf_state *hpf, unsigned band_rate)
+{
+    hpf->ba = (band_rate == 8000) ? kHpfCoefficients8kHz : kHpfCoefficients;
+    hpf->x[0] = hpf->x[1] = 0;
+    hpf->y[0] = hpf->y[1] = hpf->y[2] = hpf->y[3] = 0;
+}
+
+static void hpf_process(hpf_state *hpf, int16_t *data, unsigned length)
+{
+    unsigned i;
+    int32_t tmp_int32;
+    int16_t *y = hpf->y;
+    int16_t *x = hpf->x;
+    const int16_t *ba = hpf->ba;
+
+    for (i = 0; i < length; i++) {
+        /*  y[i] = b[0] * x[i] + b[1] * x[i-1] + b[2] * x[i-2]
+         *         + -a[1] * y[i-1] + -a[2] * y[i-2];
+         */
+        tmp_int32 = y[1] * ba[3];               /* -a[1] * y[i-1] (low)  */
+        tmp_int32 += y[3] * ba[4];              /* -a[2] * y[i-2] (low)  */
+        tmp_int32 = (tmp_int32 >> 15);
+        tmp_int32 += y[0] * ba[3];              /* -a[1] * y[i-1] (high) */
+        tmp_int32 += y[2] * ba[4];              /* -a[2] * y[i-2] (high) */
+        tmp_int32 = (int32_t)((uint32_t)tmp_int32 << 1);
+
+        tmp_int32 += data[i] * ba[0];           /* b[0] * x[0]   */
+        tmp_int32 += x[0] * ba[1];              /* b[1] * x[i-1] */
+        tmp_int32 += x[1] * ba[2];              /* b[2] * x[i-2] */
+
+        /* Update state (input part) */
+        x[1] = x[0];
+        x[0] = data[i];
+
+        /* Update state (filtered part) */
+        y[2] = y[0];
+        y[3] = y[1];
+        y[0] = (int16_t)(tmp_int32 >> 13);
+        y[1] = (int16_t)((tmp_int32 -
+                          (int32_t)((uint32_t)(int32_t)y[0] << 13)) << 2);
+
+        /* Rounding in Q12, i.e. add 2^11 */
+        tmp_int32 += 2048;
+
+        /* Saturate (to 2^27) so that the HP filtered signal does not
+         * overflow
+         */
+        if (tmp_int32 > 134217727)
+            tmp_int32 = 134217727;
+        else if (tmp_int32 < -134217728)
+            tmp_int32 = -134217728;
+
+        /* Convert back to Q0 and use rounding */
+        data[i] = (int16_t)(tmp_int32 >> 12);
+    }
+}
+#endif
+
