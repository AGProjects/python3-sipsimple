+#if !PJMEDIA_WEBRTC_AEC_USE_MOBILE
+/* Select the AEC core rate for a given device clock rate. */
+static unsigned select_core_rate(unsigned clock_rate)
+{
+    if (clock_rate == 8000 || clock_rate == 16000 || clock_rate == 32000)
+        return clock_rate;
+    return (clock_rate > 16000) ? 32000 : 16000;
+}
+
+static void free_webrtc_inst(webrtc_ec *echo)
+{
+    if (echo->AEC_inst) {
+        WebRtcAec_Free(echo->AEC_inst);
+        echo->AEC_inst = NULL;
+    }
+    if (echo->NS_inst) {
+        WebRtcNs_Free(echo->NS_inst);
+        echo->NS_inst = NULL;
+    }
+    if (echo->rs_far) {
+        pjmedia_resample_destroy(echo->rs_far);
+        echo->rs_far = NULL;
+    }
+    if (echo->rs_near) {
+        pjmedia_resample_destroy(echo->rs_near);
+        echo->rs_near = NULL;
+    }
+    if (echo->rs_out) {
+        pjmedia_resample_destroy(echo->rs_out);
+        echo->rs_out = NULL;
+    }
+}
