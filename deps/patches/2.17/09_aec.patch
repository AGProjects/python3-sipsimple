+    status = WebRtcAec_Process(echo->AEC_inst, near_bands, echo->num_bands,
+                               aec_out_bands, band_len,
+                               (int16_t)echo->tail, 0);
+    if (status != 0) {
+        print_webrtc_aec_error("Process echo", echo->AEC_inst);
+        return PJ_EUNKNOWN;
+    }
+    result = aec_out_bands;
+
+    /* 6. Noise suppression. */
+    if (echo->NS_inst) {
+        WebRtcNs_Process(echo->NS_inst, (const float *const *)aec_out_bands,
+                         echo->num_bands, ns_out_bands);
+        result = ns_out_bands;
+    }
+
+    /* 7. Merge bands and bring back to the clock rate. */
+    if (echo->num_bands == 2) {
+        float_to_int16(result[0], echo->out_lo16, band_len);
+        float_to_int16(result[1], echo->out_hi16, band_len);
+        WebRtcSpl_SynthesisQMF(echo->out_lo16, echo->out_hi16, band_len,
+                               echo->out_proc,
+                               echo->qmf_syn1, echo->qmf_syn2);
+    } else {
