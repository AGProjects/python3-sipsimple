+    status = WebRtcAec_BufferFarend(echo->AEC_inst, echo->far_f, band_len);
+    if (status != 0) {
+        print_webrtc_aec_error("Buffer farend", echo->AEC_inst);
+        return PJ_EUNKNOWN;
+    }
+
+    near_bands[0] = echo->near_f[0];
+    near_bands[1] = echo->near_f[1];
+    aec_out_bands[0] = echo->aec_out_f[0];
+    aec_out_bands[1] = echo->aec_out_f[1];
+    ns_out_bands[0] = echo->ns_out_f[0];
+    ns_out_bands[1] = echo->ns_out_f[1];
