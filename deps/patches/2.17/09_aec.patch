+    if (echo->rs_out)
+        pjmedia_resample_run(echo->rs_out, echo->out_proc, near10);
+    else
+        pjmedia_copy_samples(near10, echo->out_proc, echo->frame10_len);
+
+    return PJ_SUCCESS;
+}
