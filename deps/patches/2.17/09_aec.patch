+static void int16_to_float(const pj_int16_t *in, float *out, unsigned len)
+{
+    unsigned i;
+    for (i = 0; i < len; ++i)
+        out[i] = (float)in[i];
+}
+
+static void float_to_int16(const float *in, pj_int16_t *out, unsigned len)
+{
+    unsigned i;
+    for (i = 0; i < len; ++i) {
+        float v = in[i];
+        if (v > 32767.0f)
+            out[i] = 32767;
+        else if (v < -32768.0f)
+            out[i] = -32768;
+        else
+            out[i] = (pj_int16_t)(v >= 0 ? v + 0.5f : v - 0.5f);
+    }
+}
