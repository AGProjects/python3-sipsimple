+        if (!listed) {
+            dev_ids[dev_count++] = podcast_mixer;
+            PJ_LOG(4, (THIS_FILE, "core audio: the AG Podcast Mixer driver's hidden device added (%u)",
+                       (unsigned)podcast_mixer));
+        }
     }
     
