# 67_agpm_driver_hidden_device.patch   (pjsip 2.17)
#
# macOS: the AG Podcast Mixer is AG CuteMusic's driver (macos/driver/AGPodcastMixer.cpp). The driver hides its "AG
# Podcast Mixer" device from the system's device list (kAudioDevicePropertyIsHidden) so that other apps never offer
# it; coreaudio_dev.m adds it to its own list by its UID (kAudioHardwarePropertyTranslateUIDToDevice), after the
# listed devices, so Blink (classic and the sandboxed Blink Pro) still does.
#
# (Linux needs nothing in the SDK: AG CuteMusic's PipeWire nodes are reached through an ALSA PCM. The shared-memory
# ring device of the former patch 63 is gone.)
#
--- pjsip_orig/pjmedia/src/pjmedia-audiodev/coreaudio_dev.m
+++ pjsip/pjmedia/src/pjmedia-audiodev/coreaudio_dev.m
@@ -438,6 +438,31 @@
 }
 
 /* API: refresh the device list */
+#if COREAUDIO_MAC
+#define PJMEDIA_AGPM_DRIVER_UID     "com.ag-projects.podcast-mixer.input"     /* the driver's device, hidden */
+
+/* The AG Podcast Mixer driver's device (AG CuteMusic's macos/driver): hidden from the system's device list, so
+ * that only Blink offers it, found here by its UID; kAudioObjectUnknown when the driver is not installed. */
+static AudioDeviceID ca_hidden_podcast_mixer(void)
+{
+    AudioObjectPropertyAddress addr;
+    AudioDeviceID dev_id = kAudioObjectUnknown;
+    CFStringRef uid;
+    UInt32 size = sizeof(dev_id);
+    OSStatus ostatus;
+
+    uid = CFStringCreateWithCString(NULL, PJMEDIA_AGPM_DRIVER_UID, kCFStringEncodingUTF8);
+    if (!uid)
+        return kAudioObjectUnknown;
+    addr.mSelector = kAudioHardwarePropertyTranslateUIDToDevice;
+    addr.mScope = kAudioObjectPropertyScopeGlobal;
+    addr.mElement = AUDIO_OBJECT_ELEMENT_MAIN;
+    ostatus = AudioObjectGetPropertyData(kAudioObjectSystemObject, &addr, sizeof(uid), &uid, &size, &dev_id);
+    CFRelease(uid);
+    return ostatus == noErr ? dev_id : kAudioObjectUnknown;
+}
+#endif
+
 static pj_status_t ca_factory_refresh(pjmedia_aud_dev_factory *f)
 {
 #if !COREAUDIO_MAC
@@ -450,6 +475,7 @@
     unsigned dev_count;
     AudioObjectPropertyAddress addr;
     AudioDeviceID *dev_ids;
+    AudioDeviceID podcast_mixer;
     UInt32 buf_size, dev_size, size = sizeof(AudioDeviceID);
     AudioBufferList *buf = NULL;
     OSStatus ostatus;
@@ -472,9 +498,10 @@
         dev_size = 0;
     }
 
-    /* Calculate the number of audio devices available */
+    /* Calculate the number of audio devices available (and the driver's hidden one, added after them) */
     dev_count = dev_size / size;
-    if (dev_count==0) {
+    podcast_mixer = ca_hidden_podcast_mixer();
+    if (dev_count==0 && podcast_mixer == kAudioObjectUnknown) {
         PJ_LOG(4,(THIS_FILE, "core audio found no sound devices"));
         /* Enabling this will cause pjsua-lib initialization to fail when
          * there is no sound device installed in the system, even when pjsua
@@ -490,17 +517,32 @@
                dev_count));
 
     /* Get all the audio device IDs */
-    dev_ids = (AudioDeviceID *)pj_pool_calloc(cf->pool, dev_count, size);
+    dev_ids = (AudioDeviceID *)pj_pool_calloc(cf->pool, dev_count + 1, size);
     if (!dev_ids)
         return PJ_ENOMEM;
-    ostatus = AudioObjectGetPropertyData(kAudioObjectSystemObject, &addr,
-                                         0, NULL,
-                                         &dev_size, (void *)dev_ids);
-    if (ostatus != noErr ) {
-        /* This should not happen since we have successfully retrieved
-         * the property data size before
-         */
-        return PJMEDIA_EAUD_INIT;
+    if (dev_count > 0) {
