# 53_vid_stream_set_enc_size.patch
#
# pjmedia_vid_stream_set_enc_size(): change the size (and bitrate) a video
# stream encodes at during the call, without renegotiating. Used to send a
# shared screen ("My screen", patches 32/52) at 1280x720 while camera video
# stays at its configured size.
#
# The codec instance of a stream both encodes and decodes, on different
# threads, and no video codec here implements modify(). So the encoding side
# gets a codec instance of its own: set_enc_size() records the request and
# gives the encoding port the new size at once (a source connected from then
# on is converted to it); put_frame(), on the encoding thread, opens the new
# encoder (direction ENCODING only, ignoring the remote fmtp limits: the
# decoders we talk to, libwebrtc and FFmpeg, do not enforce the H.264 level),
# switches to it, frees the previous resized one and forces a keyframe so
# the other side's decoder follows. Frames of another size, still arriving
# until the source is connected again, are skipped. The decoder is never
# touched.
#
# Tested with H.264, VP8 and VP9 between two streams over a loop transport:
# 640x480 -> 1280x720 -> 640x480, the decoder follows each change.
--- pjsip_orig/pjmedia/include/pjmedia/vid_stream.h
+++ pjsip/pjmedia/include/pjmedia/vid_stream.h
@@ -472,6 +472,31 @@
 
 
 /**
+ * Change the size (and bitrate) the stream encodes at, during the call,
+ * without renegotiating: the encoding side gets a codec instance of its own,
+ * opened at the new size, and the next frame is a keyframe, so the other
+ * side's decoder follows. Used to send a shared screen sharper than a
+ * camera. The encoder is opened ignoring the remote fmtp limits (the H.264
+ * level), which the decoders we talk to do not enforce.
+ *
+ * The encoding port takes the new size at once: connect the source again
+ * so it is converted to it; frames of another size are skipped meanwhile.
+ *
+ * @param stream        The video media stream.
+ * @param size          The new size, even width and height.
+ * @param avg_bps       Average bitrate, 0 to keep the current one.
+ * @param max_bps       Maximum bitrate, 0 to keep the current one.
+ *
+ * @return              PJ_SUCCESS on success.
+ */
+PJ_DECL(pj_status_t)
+pjmedia_vid_stream_set_enc_size(pjmedia_vid_stream *stream,
+                                const pjmedia_rect_size *size,
+                                unsigned avg_bps,
+                                unsigned max_bps);
+
+
+/**
  * @}
  */
 
--- pjsip_orig/pjmedia/src/pjmedia/vid_stream.c
+++ pjsip/pjmedia/src/pjmedia/vid_stream.c
@@ -126,6 +126,16 @@
                                                  keyframe. */
 
     pjmedia_vid_codec       *codec;         /**< Codec instance being used. */
+
+    /* Encoder resized during the call (pjmedia_vid_stream_set_enc_size()):
+     * a codec instance of its own does the encoding, so the decoder in
+     * 'codec' is left alone. Swapped in on the encoding thread. */
+    pj_pool_t               *pool;          /**< Stream pool.               */
+    pjmedia_vid_codec       *enc_codec;     /**< Resized encoder, or NULL.  */
+    pj_bool_t                enc_resize_pending;
+    pjmedia_vid_codec_param  enc_resize_param;
+    unsigned                 enc_frame_bytes;/**< Expected input size after
+                                                 a resize, 0 before.        */
     pj_uint32_t              last_dec_ts;   /**< Last decoded timestamp.    */
     int                      last_dec_seq;  /**< Last decoded sequence.     */
 
@@ -728,6 +738,54 @@
 }
 
 
+/* Encoding thread: open an encoder at the new size and use it from now on. */
+static void apply_enc_resize(pjmedia_vid_stream *stream)
+{
+    pjmedia_stream_common *c_strm = &stream->base;
+    pjmedia_vid_codec_param param;
+    pjmedia_vid_codec *codec = NULL, *old;
+    pj_status_t status;
+
+    pj_grp_lock_acquire(c_strm->grp_lock);
+    param = stream->enc_resize_param;
+    stream->enc_resize_pending = PJ_FALSE;
+    pj_grp_lock_release(c_strm->grp_lock);
+
+    status = pjmedia_vid_codec_mgr_alloc_codec(stream->codec_mgr,
+                                               &stream->info.codec_info,
+                                               &codec);
+    if (status == PJ_SUCCESS)
+        status = pjmedia_vid_codec_init(codec, stream->pool);
+    if (status == PJ_SUCCESS)
+        status = pjmedia_vid_codec_open(codec, &param);
+    if (status != PJ_SUCCESS) {
+        PJ_PERROR(3, (c_strm->name.ptr, status,
+                      "Cannot open the encoder at %dx%d, keeping the current one",
+                      param.enc_fmt.det.vid.size.w, param.enc_fmt.det.vid.size.h));
+        if (codec)
+            pjmedia_vid_codec_mgr_dealloc_codec(stream->codec_mgr, codec);
+        return;
+    }
+
+    old = stream->enc_codec;
+    stream->enc_codec = codec;
+    if (old) {
+        pjmedia_vid_codec_close(old);
+        pjmedia_vid_codec_mgr_dealloc_codec(stream->codec_mgr, old);
+    }
+
+    /* The other side needs a keyframe to see the new size */
+    stream->force_keyframe = PJ_TRUE;
+    pj_bzero(&stream->last_keyframe_tx, sizeof(stream->last_keyframe_tx));
+
+    if (param.enc_fmt.det.vid.max_bps)
+        stream->info.rc_cfg.bandwidth = param.enc_fmt.det.vid.max_bps;
+
+    PJ_LOG(4, (c_strm->name.ptr, "Encoder now at %dx%d, %u kbps",
+               param.enc_fmt.det.vid.size.w, param.enc_fmt.det.vid.size.h,
+               param.enc_fmt.det.vid.avg_bps / 1000));
+}
+
 static pj_status_t put_frame(pjmedia_port *port,
                              pjmedia_frame *frame)
 {
@@ -748,6 +806,7 @@
