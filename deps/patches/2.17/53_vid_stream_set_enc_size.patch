     c_strm = &stream->base;
     c_strm->own_pool = own_pool;
+    stream->pool = pool;
 
     /* Init stream/port name */
     name.ptr = (char*) pj_pool_alloc(pool, M);
@@ -2049,6 +2127,11 @@
         pjmedia_vid_codec_mgr_dealloc_codec(stream->codec_mgr, stream->codec);
         stream->codec = NULL;
     }
+    if (stream->enc_codec) {
+        pjmedia_vid_codec_close(stream->enc_codec);
+        pjmedia_vid_codec_mgr_dealloc_codec(stream->codec_mgr, stream->enc_codec);
+        stream->enc_codec = NULL;
+    }
 }
 
 
@@ -2337,4 +2420,65 @@
 }
 
 
+/*
+ * Change the size (and bitrate) the stream encodes at, during the call.
+ */
+PJ_DEF(pj_status_t) pjmedia_vid_stream_set_enc_size(pjmedia_vid_stream *stream,
+                                                    const pjmedia_rect_size *size,
+                                                    unsigned avg_bps,
+                                                    unsigned max_bps)
+{
+    pjmedia_stream_common *c_strm;
+    pjmedia_vid_codec_param *param;
+    const pjmedia_video_format_info *vfi;
+    pjmedia_video_apply_fmt_param vafp;
+    pjmedia_port_info *pi;
+
+    PJ_ASSERT_RETURN(stream && size, PJ_EINVAL);
+    PJ_ASSERT_RETURN(size->w >= 16 && size->h >= 16 && !(size->w & 1) &&
+                     !(size->h & 1), PJ_EINVAL);
+    c_strm = &stream->base;
+    if (!c_strm->enc || !stream->info.codec_param)
+        return PJ_EINVALIDOP;
+
+    pj_grp_lock_acquire(c_strm->grp_lock);
+
+    pi = &c_strm->enc->port.info;
+    vfi = pjmedia_get_video_format_info(NULL, pi->fmt.id);
+    pj_bzero(&vafp, sizeof(vafp));
+    vafp.size = *size;
+    if (!vfi || vfi->apply_fmt(vfi, &vafp) != PJ_SUCCESS) {
+        pj_grp_lock_release(c_strm->grp_lock);
+        return PJMEDIA_EBADFMT;
+    }
+
+    param = &stream->enc_resize_param;
+    pj_memcpy(param, stream->info.codec_param, sizeof(*param));
+    param->dir = PJMEDIA_DIR_ENCODING;      /* the decoder stays as it is */
+    param->enc_fmt.det.vid.size = *size;
+    if (avg_bps)
+        param->enc_fmt.det.vid.avg_bps = avg_bps;
+    if (max_bps)
+        param->enc_fmt.det.vid.max_bps = max_bps;
+    /* The size asked for, not what the remote's H.264 level allows: the
+     * decoders we talk to (libwebrtc, FFmpeg) do not enforce the level. */
+    param->ignore_fmtp = PJ_TRUE;
+    stream->enc_resize_pending = PJ_TRUE;
+
+    /* The port takes the new size now: a source connected from now on is
+     * converted to it. Frames of another size are skipped until then. */
+    pi->fmt.det.vid.size = *size;
+    if (avg_bps)
+        pi->fmt.det.vid.avg_bps = avg_bps;
+    if (max_bps)
+        pi->fmt.det.vid.max_bps = max_bps;
+    stream->info.codec_param->enc_fmt.det.vid.size = *size;
+    stream->enc_frame_bytes = (unsigned)vafp.framebytes;
+
+    pj_grp_lock_release(c_strm->grp_lock);
+
+    PJ_LOG(4, (c_strm->name.ptr, "Encoder size %dx%d requested", size->w, size->h));
+    return PJ_SUCCESS;
+}
