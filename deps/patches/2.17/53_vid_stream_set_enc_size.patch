     send_entry *send_entry = NULL;
     void *send_buf;
+    pjmedia_vid_codec *codec;
 
 #if defined(PJMEDIA_STREAM_ENABLE_KA) && PJMEDIA_STREAM_ENABLE_KA != 0
     /* If the interval since last sending packet is greater than
@@ -801,6 +860,24 @@
         return PJ_SUCCESS;
     }
 
+    /* A new encoder size asked for: switch encoders here, on the encoding
+     * thread, between two frames. */
+    if (stream->enc_resize_pending)
+        apply_enc_resize(stream);
+    codec = stream->enc_codec ? stream->enc_codec : stream->codec;
+
+    /* After a resize, frames of the old size can still come until the
+     * source is connected again (and converted to the new size): the
+     * encoder must never read past what it was given. */
+    if (stream->enc_frame_bytes && frame->type == PJMEDIA_FRAME_TYPE_VIDEO &&
+        frame->size != stream->enc_frame_bytes)
+    {
+        pjmedia_rtp_encode_rtp(&channel->rtp, channel->pt, 1, 0,
+                               rtp_ts_len, (const void**)&rtphdr,
+                               &rtphdrlen);
+        return PJ_SUCCESS;
+    }
+
     /* Init frame_out buffer. */
     pj_bzero(&frame_out, sizeof(frame_out));
     if (stream->info.rc_cfg.method == PJMEDIA_VID_STREAM_RC_SEND_THREAD) {
@@ -845,7 +922,7 @@
     }
 
     /* Encode! */
-    status = pjmedia_vid_codec_encode_begin(stream->codec, &enc_opt, frame,
+    status = pjmedia_vid_codec_encode_begin(codec, &enc_opt, frame,
                                             channel->buf_size -
                                                sizeof(pjmedia_rtp_hdr),
                                             &frame_out,
@@ -939,7 +1016,7 @@
