+                                       csrc_levels_reserve(stream),
                                        &frame_out);
         if (status != PJ_SUCCESS) {
             LOGERR_((c_strm->port.info.name.ptr, status,
@@ -1257,6 +1345,12 @@
     /* Copy RTP header to the beginning of packet */
