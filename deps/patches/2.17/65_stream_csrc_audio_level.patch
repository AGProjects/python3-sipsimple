 }
+
+
+/*
+ * Send the sources mixed into what the stream sends (RFC 6465).
+ */
+PJ_DEF(pj_status_t)
+pjmedia_stream_set_csrc_level_ext(pjmedia_stream *stream,
+                                  int level_ext_id, int lr_ext_id)
+{
+    PJ_ASSERT_RETURN(stream, PJ_EINVAL);
+    PJ_ASSERT_RETURN(level_ext_id >= 0 && level_ext_id <= 14, PJ_EINVAL);
+    PJ_ASSERT_RETURN(lr_ext_id >= 0 && lr_ext_id <= 14, PJ_EINVAL);
+
+    stream->csrc_level_ext_id = level_ext_id;
+    stream->csrc_lr_ext_id = level_ext_id ? lr_ext_id : 0;
+    if (!level_ext_id)
+        stream->csrc_cnt = 0;
+    return PJ_SUCCESS;
+}
+
+
+/*
+ * The sources mixed into the next frames, and their levels.
+ */
+PJ_DEF(pj_status_t)
+pjmedia_stream_set_csrc_levels(pjmedia_stream *stream, unsigned count,
+                               const pjmedia_stream_csrc_level levels[])
+{
+    PJ_ASSERT_RETURN(stream && (count == 0 || levels), PJ_EINVAL);
+
+    if (count > PJMEDIA_STREAM_MAX_CSRC)
+        count = PJMEDIA_STREAM_MAX_CSRC;
+    if (count)
+        pj_memcpy(stream->csrc_levels, levels, count * sizeof(levels[0]));
+    stream->csrc_cnt = count;
+    return PJ_SUCCESS;
+}
