+                remove_rtcp_fb(offer, fmt);
+
                 /* Remove this format from offer's array */
                 pj_array_erase(offer->desc.fmt, sizeof(offer->desc.fmt[0]),
                                offer->desc.fmt_count, i);
@@ -998,6 +1025,9 @@
