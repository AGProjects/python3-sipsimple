     for (i = 0; i < a_tmp_cnt; ++i)
         pjmedia_sdp_media_add_attr(answer, a_tmp[i]);
 }
@@ -1657,6 +1715,9 @@
         if (a) {
             pjmedia_sdp_media_remove_attr(answer, a);
         }
+
+        /* Remove rtcp-fb for this format */
