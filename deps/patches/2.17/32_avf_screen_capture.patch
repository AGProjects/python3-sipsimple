+/****************************************************************************
+ * Screen capture
+ */
+#if AVF_HAS_SCK
+
+static const char *avf_error_str(NSError *error)
+{
+    const char *s = error ? [[error localizedDescription] UTF8String] : NULL;
+    return s ? s : "unknown error";
+}
+
+API_AVAILABLE(macos(12.3))
+@interface AVFScreenOutput: NSObject <SCStreamOutput, SCStreamDelegate>
+{
+@public
+    struct avf_stream *stream;
+}
+@end
+
+@implementation AVFScreenOutput
+/* Runs on sc_queue */
+- (void)stream:(SCStream *)sc didOutputSampleBuffer:(CMSampleBufferRef)sampleBuffer
+        ofType:(SCStreamOutputType)type
+{
+    CFArrayRef attachments;
+    NSDictionary *info;
+    NSNumber *frame_status;
+    CVImageBufferRef img;
+
+    PJ_UNUSED_ARG(sc);
+
+    if (!stream || type != SCStreamOutputTypeScreen || !sampleBuffer ||
+        !CMSampleBufferIsValid(sampleBuffer))
+    {
+        return;
+    }
+
+    /* Only complete frames carry an image, idle/blank/etc. are status
+     * notifications; the last image keeps being repeated by the timer. */
+    attachments = CMSampleBufferGetSampleAttachmentsArray(sampleBuffer, false);
+    if (!attachments || CFArrayGetCount(attachments) == 0)
+        return;
+    info = (NSDictionary *)CFArrayGetValueAtIndex(attachments, 0);
+    frame_status = [info objectForKey:SCStreamFrameInfoStatus];
+    if (!frame_status || [frame_status integerValue] != SCFrameStatusComplete)
+        return;
+
+    img = CMSampleBufferGetImageBuffer(sampleBuffer);
+    if (!img || CVPixelBufferGetPixelFormatType(img) != kCVPixelFormatType_32BGRA)
+        return;
+
+    CVPixelBufferRetain(img);
+    if (stream->sc_last_buf)
+        CVPixelBufferRelease(stream->sc_last_buf);
+    stream->sc_last_buf = img;
+}
+
+- (void)stream:(SCStream *)sc didStopWithError:(NSError *)error
+{
+    PJ_UNUSED_ARG(sc);
+    PJ_LOG(3, (THIS_FILE, "Screen capture stopped by the system: %s", avf_error_str(error)));
+}
+@end
+
+/* Timer handler, runs on sc_queue: send the latest screen image */
+static void sck_tick(struct avf_stream *strm)
+{
+    CVPixelBufferRef img = strm->sc_last_buf;
+    pjmedia_frame frame;
+    size_t width, height, bpr;
+    pj_uint8_t *base;
+
+    if (!strm->is_running || !img)
+        return;
+
+    if (strm->cap_thread_initialized == 0 || !pj_thread_is_registered()) {
+        pj_bzero(strm->cap_thread_desc, sizeof(pj_thread_desc));
+        pj_thread_register("avf_screen", strm->cap_thread_desc, &strm->cap_thread);
+        strm->cap_thread_initialized = 1;
+    }
+
+    if (CVPixelBufferLockBaseAddress(img, kCVPixelBufferLock_ReadOnly) != kCVReturnSuccess)
+        return;
+
+    width = CVPixelBufferGetWidth(img);
+    height = CVPixelBufferGetHeight(img);
+    bpr = CVPixelBufferGetBytesPerRow(img);
+    base = (pj_uint8_t *)CVPixelBufferGetBaseAddress(img);
+
+    /* vid_port sizes its converter from the negotiated format, never hand
+     * it anything else. */
+    if (base && width == strm->size.w && height == strm->size.h && bpr >= width * 4) {
+        pj_bzero(&frame, sizeof(frame));
+        frame.type = PJMEDIA_FRAME_TYPE_VIDEO;
+        frame.timestamp.u64 = strm->cap_frame_ts.u64;
+        frame.size = width * 4 * height;
+
+        if (bpr == width * 4) {
+            frame.buf = base;
+        } else {
+            /* Row padding: pack it, pjmedia expects tight BGRA rows */
+            size_t row;
+            if (!strm->sc_pack_buf)
+                strm->sc_pack_buf = (pj_uint8_t *)pj_pool_alloc(strm->pool, frame.size);
+            for (row = 0; row < height; row++)
+                pj_memcpy(strm->sc_pack_buf + row * width * 4, base + row * bpr, width * 4);
+            frame.buf = strm->sc_pack_buf;
+        }
+
+        if (strm->vid_cb.capture_cb)
+            (*strm->vid_cb.capture_cb)(&strm->base, strm->user_data, &frame);
+
+        strm->cap_frame_ts.u64 += strm->cap_ts_inc;
+    }
+
+    CVPixelBufferUnlockBaseAddress(img, kCVPixelBufferLock_ReadOnly);
+}
+
+API_AVAILABLE(macos(12.3))
+static pj_status_t sck_create(struct avf_stream *strm)
+{
+    __block SCDisplay *display = nil;
+    __block NSError *content_error = nil;
+    CGDirectDisplayID display_id = strm->display_id;
+    NSAutoreleasePool *apool;
+    dispatch_semaphore_t sem;
+    long timed_out;
+    const pjmedia_video_format_detail *vfd;
+    SCStreamConfiguration *config;
+    SCContentFilter *filter;
+    AVFScreenOutput *output;
+    SCStream *sc;
+    NSError *error = nil;
+    pj_status_t status = PJ_SUCCESS;
+
+    /* Without the Screen Recording permission SCK hands out black frames
+     * or fails. Trigger the system prompt and fail, so the application
+     * falls back to a camera. Access is effective once the user granted
+     * it (usually requires restarting the application). */
+    if (!CGPreflightScreenCaptureAccess()) {
+        PJ_LOG(3, (THIS_FILE, "Screen Recording permission is not granted, requesting it"));
+        CGRequestScreenCaptureAccess();
+        return PJMEDIA_EVID_NOTREADY;
+    }
+
+    sem = dispatch_semaphore_create(0);
+    [SCShareableContent getShareableContentWithCompletionHandler:^(SCShareableContent *content, NSError *err) {
+        if (err) {
+            content_error = [err retain];
+        } else {
+            for (SCDisplay *d in content.displays) {
+                if (d.displayID == display_id) {
+                    display = [d retain];
+                    break;
+                }
+            }
+        }
+        dispatch_semaphore_signal(sem);
+    }];
+    timed_out = dispatch_semaphore_wait(sem, dispatch_time(DISPATCH_TIME_NOW, AVF_SCK_TIMEOUT));
+    dispatch_release(sem);
+
+    if (timed_out) {
+        /* The handler may still run later; it only leaks its retains. */
+        PJ_LOG(3, (THIS_FILE, "Timed out getting the shareable screen content"));
+        return PJMEDIA_EVID_SYSERR;
+    }
+    if (content_error) {
+        PJ_LOG(3, (THIS_FILE, "Cannot get the shareable screen content: %s", avf_error_str(content_error)));
+        [content_error release];
+        return PJMEDIA_EVID_SYSERR;
+    }
+    if (!display) {
+        PJ_LOG(3, (THIS_FILE, "Display %u is no longer available", (unsigned)display_id));
+        return PJMEDIA_EVID_INVDEV;
+    }
+
+    apool = [[NSAutoreleasePool alloc] init];
+
+    vfd = pjmedia_format_get_video_format_detail(&strm->param.fmt, PJ_TRUE);
+
+    config = [[SCStreamConfiguration alloc] init];
+    config.width = strm->size.w;
+    config.height = strm->size.h;
+    config.pixelFormat = kCVPixelFormatType_32BGRA;
+    config.minimumFrameInterval = CMTimeMake(vfd->fps.denum, vfd->fps.num);
+    config.showsCursor = YES;
+    config.queueDepth = 5;
+#ifdef __MAC_14_0
+    if (@available(macOS 14.0, *)) {
+        /* Letterbox instead of stretching a 16:10 display into 16:9 */
+        config.preservesAspectRatio = YES;
+    }
+#endif
+
+    filter = [[SCContentFilter alloc] initWithDisplay:display excludingWindows:[NSArray array]];
+    output = [[AVFScreenOutput alloc] init];
+    output->stream = strm;
+    sc = [[SCStream alloc] initWithFilter:filter configuration:config delegate:output];
+    [filter release];
+    [config release];
+    [display release];
+
+    strm->sc_queue = dispatch_queue_create("AVF Screen", DISPATCH_QUEUE_SERIAL);
+    strm->sc_output = output;
+    strm->sc_stream = sc;
+
+    if (!sc || ![sc addStreamOutput:output type:SCStreamOutputTypeScreen
+                 sampleHandlerQueue:strm->sc_queue error:&error])
+    {
+        PJ_LOG(3, (THIS_FILE, "Cannot create the screen capture stream: %s", avf_error_str(error)));
+        status = PJMEDIA_EVID_SYSERR;
+    } else {
+        PJ_LOG(4, (THIS_FILE, "Screen capture of display %u at %dx%d",
+                   (unsigned)display_id, strm->size.w, strm->size.h));
+    }
+
+    [apool release];
+
+    /* On failure the partially set up objects go in sck_destroy() */
+    return status;
+}
+
+API_AVAILABLE(macos(12.3))
+static pj_status_t sck_start(struct avf_stream *strm)
+{
+    __block NSError *start_error = nil;
+    const pjmedia_video_format_detail *vfd;
+    dispatch_semaphore_t sem;
+    long timed_out;
+    uint64_t interval;
+
+    if (strm->is_running)
+        return PJ_SUCCESS;
+    if (!strm->sc_stream)
+        return PJMEDIA_EVID_NOTREADY;
+
+    /* Set before starting: if the start times out it may still complete
+     * later, stop has to undo it. */
+    strm->sc_capturing = PJ_TRUE;
+
+    sem = dispatch_semaphore_create(0);
+    [(SCStream *)strm->sc_stream startCaptureWithCompletionHandler:^(NSError *err) {
+        if (err)
+            start_error = [err retain];
+        dispatch_semaphore_signal(sem);
+    }];
+    timed_out = dispatch_semaphore_wait(sem, dispatch_time(DISPATCH_TIME_NOW, AVF_SCK_TIMEOUT));
+    dispatch_release(sem);
+
+    if (timed_out) {
+        PJ_LOG(3, (THIS_FILE, "Timed out starting screen capture"));
+        return PJMEDIA_EVID_NOTREADY;
+    }
+    if (start_error) {
+        PJ_LOG(3, (THIS_FILE, "Cannot start screen capture: %s", avf_error_str(start_error)));
+        [start_error release];
+        return PJMEDIA_EVID_NOTREADY;
+    }
+
+    dispatch_sync(strm->sc_queue, ^{
+        strm->is_running = PJ_TRUE;
+    });
+
+    vfd = pjmedia_format_get_video_format_detail(&strm->param.fmt, PJ_TRUE);
+    interval = (uint64_t)NSEC_PER_SEC * vfd->fps.denum / vfd->fps.num;
+
+    strm->sc_timer = dispatch_source_create(DISPATCH_SOURCE_TYPE_TIMER, 0, 0, strm->sc_queue);
+    dispatch_source_set_timer(strm->sc_timer,
+                              dispatch_time(DISPATCH_TIME_NOW, (int64_t)interval),
+                              interval, interval / 10);
+    dispatch_source_set_event_handler(strm->sc_timer, ^{
+        sck_tick(strm);
+    });
+    dispatch_resume(strm->sc_timer);
+
+    return PJ_SUCCESS;
+}
+
+API_AVAILABLE(macos(12.3))
+static void sck_stop(struct avf_stream *strm)
+{
+    if (strm->sc_timer)
+        dispatch_source_cancel(strm->sc_timer);
+
+    /* Waits for a tick in progress; no new ticks start after cancel */
+    if (strm->sc_queue) {
+        dispatch_sync(strm->sc_queue, ^{
+            strm->is_running = PJ_FALSE;
+            if (strm->sc_last_buf) {
+                CVPixelBufferRelease(strm->sc_last_buf);
+                strm->sc_last_buf = NULL;
+            }
+        });
+    }
+
+    if (strm->sc_timer) {
+        dispatch_release(strm->sc_timer);
+        strm->sc_timer = NULL;
+    }
+
+    if (strm->sc_stream && strm->sc_capturing) {
+        dispatch_semaphore_t sem = dispatch_semaphore_create(0);
+
+        strm->sc_capturing = PJ_FALSE;
+        [(SCStream *)strm->sc_stream stopCaptureWithCompletionHandler:^(NSError *err) {
+            PJ_UNUSED_ARG(err);
+            dispatch_semaphore_signal(sem);
+        }];
+        if (dispatch_semaphore_wait(sem, dispatch_time(DISPATCH_TIME_NOW, AVF_SCK_TIMEOUT)))
+            PJ_LOG(3, (THIS_FILE, "Timed out stopping screen capture"));
+        dispatch_release(sem);
+    }
+}
+
+API_AVAILABLE(macos(12.3))
+static void sck_destroy(struct avf_stream *strm)
+{
+    SCStream *sc = strm->sc_stream;
+    AVFScreenOutput *output = strm->sc_output;
+
+    sck_stop(strm);
+
+    if (sc) {
