+    PJ_UNUSED_ARG(strm);
+    return PJMEDIA_EVID_NOTREADY;
+}
+
+static void screen_stream_stop(struct avf_stream *strm)
+{
+#if AVF_HAS_SCK
+    if (@available(macOS 12.3, *)) {
+        sck_stop(strm);
+    }
+#endif
+    PJ_UNUSED_ARG(strm);
+}
+
+static void screen_stream_destroy(struct avf_stream *strm)
+{
+#if AVF_HAS_SCK
+    if (@available(macOS 12.3, *)) {
+        sck_destroy(strm);
+    }
+#endif
+    PJ_UNUSED_ARG(strm);
+}
