# 32_avf_screen_capture.patch
#
# Screen sharing as a video capture device on macOS.
#
# avf_dev.m lists every active display after the cameras, as "My screen"
# (main display), "My screen 2", ... Selecting one as the camera sends
# the screen instead of camera video; nothing changes above pjmedia.
#
# Capture uses ScreenCaptureKit (macOS 12.3+), weak-linked; on older
# systems no screen devices are listed. Needs the Screen Recording
# permission: without it the first open triggers the system prompt and
# fails with PJMEDIA_EVID_NOTREADY, so the application falls back to a
# camera.
#
# SCK delivers a frame only when the screen changes, while the video
# stream packetizer advances the RTP timestamp by a fixed amount per
# frame. The SCK callback therefore only keeps the latest buffer and a
# dispatch timer at the configured frame rate hands it to pjmedia, which
# keeps timing right and lets keyframe requests be served on a static
# screen. Output is BGRA at the requested size, letterboxed (macOS 14+).
#
# Also fixes two bugs in the existing camera path hit by failure handling:
#  - init_avf_stream() stored errors in a dead local, reporting success
#    for a session without input/output
#  - avf_factory_create_stream() released video_ops_queue before calling
#    avf_stream_destroy(), which dispatches on it and releases it again
#
# aconfigure(.ac): add -weak_framework ScreenCaptureKit to LIBS when it
# links (macOS SDK only, not iOS).
--- pjsip_orig/aconfigure.ac
+++ pjsip/aconfigure.ac
@@ -1296,6 +1296,24 @@
                 AC_MSG_RESULT([Checking if OpenGLES framework is available... no])
             fi
 
+            # ScreenCaptureKit (macOS 12.3+) backs the "My screen" capture
+            # devices in avf_dev.m. Weak-linked so older macOS still loads.
+            if test "$ac_pjmedia_video_has_darwin" = "yes"; then
+                SCK_SAVED_LIBS="$LIBS"
+                LIBS="-framework ScreenCaptureKit"
+                AC_LINK_IFELSE(
+                    [AC_LANG_PROGRAM([[]], [])],
+                    [ac_pjmedia_video_has_sck=yes],
+                    [ac_pjmedia_video_has_sck=no])
+                LIBS="$SCK_SAVED_LIBS"
+                if test "$ac_pjmedia_video_has_sck" = "yes"; then
+                    LIBS="$LIBS -weak_framework ScreenCaptureKit"
+                    AC_MSG_RESULT([Checking if ScreenCaptureKit framework is available... yes])
+                else
+                    AC_MSG_RESULT([Checking if ScreenCaptureKit framework is available... no])
+                fi
+            fi
+
             if false; then
                 # QTKit is deprecated, see ticket #1931.
                 ac_pjmedia_video=mac_os
