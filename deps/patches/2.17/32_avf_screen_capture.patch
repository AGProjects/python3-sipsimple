+#if AVF_HAS_SCK
+/* Active displays that can be captured, main display first so it always
+ * gets the plain AVF_SCREEN_NAME. Displays mirroring another display are
+ * skipped since they show the same content. */
+static unsigned avf_get_screens(CGDirectDisplayID *out, unsigned max)
+{
+    CGDirectDisplayID active[AVF_MAX_SCREENS];
+    CGDirectDisplayID main_id;
+    uint32_t n_active = 0, i;
+    unsigned n = 0;
+
+    if (@available(macOS 12.3, *)) {
+        /* ScreenCaptureKit present */
+    } else {
+        return 0;
+    }
+
+    if (CGGetActiveDisplayList(AVF_MAX_SCREENS, active, &n_active) != kCGErrorSuccess)
+        return 0;
+
+    main_id = CGMainDisplayID();
+    for (i = 0; i < n_active && n < max; i++) {
+        if (active[i] == main_id)
+            out[n++] = active[i];
+    }
+    for (i = 0; i < n_active && n < max; i++) {
+        if (active[i] == main_id)
+            continue;
+        if (CGDisplayMirrorsDisplay(active[i]) != kCGNullDirectDisplay)
+            continue;
+        out[n++] = active[i];
+    }
+
+    return n;
+}
+
+static void avf_add_screens(struct avf_factory *af,
+                            const CGDirectDisplayID *screens,
+                            unsigned n_screens,
+                            unsigned max_count)
+{
+    /* SCK scales the display into whatever size is configured, so any
+     * size is possible. Offer the usual ones so vid_port's closest-format
+     * match lands exactly on the resolution the application asked for. */
+    static const struct { unsigned w, h; } sizes[] = {
+        {1920, 1080}, {1280, 720}, {2560, 1440}, {3840, 2160},
+        {960, 540}, {640, 360}, {1024, 768}, {640, 480}
+    };
+    unsigned i, j;
+
+    for (i = 0; i < n_screens; i++) {
+        struct avf_dev_info *di;
+
+        if (af->dev_count >= max_count)
+            break;
+
+        di = &af->dev_info[af->dev_count++];
+        pj_bzero(di, sizeof(*di));
+        di->is_screen = PJ_TRUE;
+        di->display_id = screens[i];
+
+        if (i == 0)
+            pj_ansi_snprintf(di->info.name, sizeof(di->info.name), "%s", AVF_SCREEN_NAME);
+        else
+            pj_ansi_snprintf(di->info.name, sizeof(di->info.name), "%s %u", AVF_SCREEN_NAME, i + 1);
+        pj_ansi_strncpy(di->info.driver, "AVF", sizeof(di->info.driver));
+        di->info.dir = PJMEDIA_DIR_CAPTURE;
+        di->info.has_callback = PJ_TRUE;
+        di->info.caps = PJMEDIA_VID_DEV_CAP_FORMAT;
+        di->info.fmt_cnt = 0;
+
+        for (j = 0; j < PJ_ARRAY_SIZE(sizes) && di->info.fmt_cnt < PJMEDIA_VID_DEV_INFO_FMT_CNT; j++) {
+            pjmedia_format_init_video(&di->info.fmt[di->info.fmt_cnt++],
+                                      PJMEDIA_FORMAT_BGRA,
+                                      sizes[j].w, sizes[j].h,
+                                      DEFAULT_FPS, 1);
+        }
+
+        PJ_LOG(4, (THIS_FILE, " dev: %s (display %u)", di->info.name, (unsigned)di->display_id));
+    }
+}
+#endif	/* AVF_HAS_SCK */
