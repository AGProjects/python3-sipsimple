# 52_linux_screen_capture.patch
#
# Screen sharing as a video capture device on Linux, the counterpart of
# patch 32 (macOS): "My screen" is listed after the cameras, and picking it
# as the camera sends a monitor instead of camera video. Nothing changes
# above pjmedia; the call is an ordinary video call.
#
# Capture goes through the xdg-desktop-portal ScreenCast interface (GIO /
# GDBus) and PipeWire, the only way that works on Wayland; GNOME and KDE
# also offer it on X11 sessions. The handshake (CreateSession,
# SelectSources, Start, OpenPipeWireRemote) runs on a thread of its own,
# started by pjmedia_screen_dev_request(), because Start shows the desktop's
# picker; the application opens the device once pjmedia_screen_dev_get_info()
# says READY. Opening it at any other time fails with PJMEDIA_EVID_NOTREADY
# (the SDK falls back to a camera) and shows nothing, so a "My screen" left
# in the settings does not pop the picker up at start. With a restore token
# (ScreenCast v4, persist_mode 2) the picker is skipped. When sharing is
# stopped from the desktop (its indicator), the state goes to ENDED: the
# portal session's Closed signal is watched on a thread of its own while a
# stream captures, as the PipeWire stream does not always change state then.
#
# Only monitors are offered (not windows) so a remote pointer lands on a
# known place, and the cursor is embedded in the frames when the portal can.
#
# As on macOS, PipeWire delivers a frame only on damage: the newest buffer
# is held and a pjmedia clock at the configured rate converts it (libswscale,
# letterboxed I420 at the requested size) and hands it to pjmedia, which
# keeps RTP timing right and serves keyframe requests on a static screen.
# Shared memory buffers only (MemFd/MemPtr), no DMA-BUF import. The
# PipeWire thread registers with pjlib before it logs.
#
# Built when PJMEDIA_VIDEO_DEV_HAS_SCREEN=1 (setup_pjsip.py sets it on Linux
# when pkg-config finds libpipewire-0.3, gio-2.0 and gio-unix-2.0) and
# FFmpeg's libswscale is in. screen_dev.c is compiled on every platform:
# without the device it only defines the pjmedia_screen_dev_* functions as
# stubs, which the Cython core calls unconditionally.
--- pjsip_orig/pjmedia/include/pjmedia-videodev/config.h
+++ pjsip/pjmedia/include/pjmedia-videodev/config.h
@@ -223,6 +223,18 @@
 
 
 /**
+ * Linux screen capture ("My screen") through the xdg-desktop-portal
+ * ScreenCast interface and PipeWire. Needs libpipewire-0.3, GIO and
+ * libswscale.
+ *
+ * Default: 0
+ */
+#ifndef PJMEDIA_VIDEO_DEV_HAS_SCREEN
+#   define PJMEDIA_VIDEO_DEV_HAS_SCREEN         0
+#endif
+
+
+/**
  * Enable support for AVI player virtual capture device.
  *
  * Default: 1
--- pjsip_orig/pjmedia/include/pjmedia_videodev.h
+++ pjsip/pjmedia/include/pjmedia_videodev.h
@@ -27,5 +27,6 @@
 #include <pjmedia-videodev/videodev_imp.h>
 #include <pjmedia-videodev/avi_dev.h>
 #include <pjmedia-videodev/fb_dev.h>
+#include <pjmedia-videodev/screen_dev.h>
 
 #endif  /* __PJMEDIA_VIDEODEV_H__ */
