 #endif
 
+#if PJMEDIA_VIDEO_DEV_HAS_SCREEN && defined(PJMEDIA_HAS_LIBSWSCALE) && PJMEDIA_HAS_LIBSWSCALE
+pjmedia_vid_dev_factory* pjmedia_screen_factory(pj_pool_factory *pf);
+#endif
+
 #if PJMEDIA_VIDEO_DEV_HAS_FB
