# 64_conf_signal_level_channels.patch   (pjsip 2.17)
#
# Signal levels per channel on a stereo conference bridge.
#
# The bridge keeps one tx and one rx level per port (the mean absolute
# sample of the last frame, as 8 bit complement ulaw), taken over the
# interleaved samples of both channels on a stereo bridge: left and right
# are lost.  SylkServer's stereo conference rooms (a stereo AudioMixer,
# python3-sipsimple's audio.stereo / channel_count=2) publish each
# participant's level to the clients' VU meters and want them per channel.
#
# Each port now also keeps the level of each channel (left, right) of the
# frames it sends and receives, computed alongside the whole-frame level
# (the same frame, the same scale), and
# pjmedia_conf_get_signal_level_channels() returns them.  A mono bridge
# gives the whole-frame level twice.  The existing level and
# pjmedia_conf_get_signal_level() are unchanged.
#
# Group 2 in README (an accessor for sipsimple's Cython bindings:
# AudioMixer.get_signal_level_channels()).
#
--- pjsip_orig/pjmedia/include/pjmedia/conference.h
+++ pjsip/pjmedia/include/pjmedia/conference.h
@@ -804,6 +804,26 @@
 
 
 /**
+ * Get last signal level transmitted to or received from the specified port,
+ * per channel: left and right on a stereo bridge, the same level twice on a
+ * mono one. Same scale as pjmedia_conf_get_signal_level() (0 to 255).
+ *
+ * @param conf          The conference bridge.
+ * @param slot          Slot number.
+ * @param tx_level      Optional array of two receiving the levels (left,
+ *                      right) transmitted to the port.
+ * @param rx_level      Optional array of two receiving the levels (left,
+ *                      right) received from the port.
+ *
+ * @return              PJ_SUCCESS on success.
+ */
+PJ_DECL(pj_status_t) pjmedia_conf_get_signal_level_channels(pjmedia_conf *conf,
+                                                            unsigned slot,
+                                                            unsigned tx_level[2],
+                                                            unsigned rx_level[2]);
+
+
+/**
  * Adjust the level of signal received from the specified port.
  * Application may adjust the level to make signal received from the port
  * either louder or more quiet. The level adjustment is calculated with this
--- pjsip_orig/pjmedia/src/pjmedia/conference.c
+++ pjsip/pjmedia/src/pjmedia/conference.c
@@ -131,6 +131,9 @@
     /* Calculated signal levels: */
     unsigned             tx_level;      /**< Last tx level to this port.    */
     unsigned             rx_level;      /**< Last rx level from this port.  */
+    unsigned             tx_level_ch[2];/**< Last tx level, per channel of a
+                                             stereo bridge (left, right).   */
+    unsigned             rx_level_ch[2];/**< Last rx level, per channel.    */
 
     /* The normalized signal level adjustment.
      * A value of 128 (NORMAL_LEVEL) means there's no adjustment.
@@ -2191,6 +2194,45 @@
 
 
 /*
+ * Get signal level per channel (left, right).
+ */
+PJ_DEF(pj_status_t) pjmedia_conf_get_signal_level_channels(pjmedia_conf *conf,
+                                                           unsigned slot,
+                                                           unsigned tx_level[2],
+                                                           unsigned rx_level[2])
+{
+    struct conf_port *conf_port;
+
+    PJ_ASSERT_RETURN(conf && slot<conf->max_ports, PJ_EINVAL);
+
+    pj_mutex_lock(conf->mutex);
+
+    conf_port = conf->ports[slot];
+    if (conf_port == NULL) {
+        pj_mutex_unlock(conf->mutex);
+        return PJ_EINVAL;
+    }
+
+    /* The whole-frame level is reset to zero where no frame flows (port
+     * disabled or muted, nobody transmitting, no frame read): the channel
+     * levels, set with each frame only, follow it.
+     */
+    if (tx_level != NULL) {
+        tx_level[0] = conf_port->tx_level ? conf_port->tx_level_ch[0] : 0;
+        tx_level[1] = conf_port->tx_level ? conf_port->tx_level_ch[1] : 0;
+    }
+    if (rx_level != NULL) {
+        rx_level[0] = conf_port->rx_level ? conf_port->rx_level_ch[0] : 0;
+        rx_level[1] = conf_port->rx_level ? conf_port->rx_level_ch[1] : 0;
+    }
+
+    pj_mutex_unlock(conf->mutex);
+
+    return PJ_SUCCESS;
+}
+
+
+/*
  * Adjust RX level of individual port.
  */
 PJ_DEF(pj_status_t) pjmedia_conf_adjust_rx_level( pjmedia_conf *conf,
@@ -2468,6 +2510,35 @@
 /*
  * Write the mixed signal to the port.
  */
+/*
+ * The level of each channel of a frame of a stereo bridge (interleaved
+ * left, right), as the level of the whole frame (8 bit complement ulaw):
+ * level is that whole-frame level, copied to both on a mono bridge.
+ */
+static void channel_levels(pjmedia_conf *conf, const pj_int16_t *buf,
+                           unsigned level, unsigned levels[2])
+{
+    pj_int32_t left = 0, right = 0;
+    unsigned j, frames;
+
+    if (conf->channel_count != 2) {
+        levels[0] = levels[1] = level;
+        return;
+    }
+    frames = conf->samples_per_frame / 2;
+    for (j = 0; j < frames; ++j) {
+        left  += (buf[2*j]   >= 0 ? buf[2*j]   : -buf[2*j]);
+        right += (buf[2*j+1] >= 0 ? buf[2*j+1] : -buf[2*j+1]);
+    }
+    if (frames) {
+        left /= frames;
+        right /= frames;
+    }
+    levels[0] = pjmedia_linear2ulaw(left) ^ 0xff;
+    levels[1] = pjmedia_linear2ulaw(right) ^ 0xff;
+}
+
