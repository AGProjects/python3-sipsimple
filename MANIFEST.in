include AUTHORS
include LICENSE
include README
include MANIFEST.in

include build_inplace
include setup_pjsip.py
include get_dependencies.sh

include sipsimple/payloads/xml-schemas/*.xsd
include sipsimple/util/_sha1.h

include debian/changelog
include debian/compat
include debian/control
include debian/copyright
include debian/dirs
include debian/docs
include debian/pycompat
include debian/pyversions
include debian/python-sipsimple.lintian-overrides
include debian/python-sipsimple-dbg.lintian-overrides
include debian/rules
include debian/source/format

recursive-include docs *
recursive-include deps *
# deps/pjsip is generated by get_dependencies.sh (debian/rules runs it on
# every build); never ship a pre-patched tree or old pjproject tarballs.
prune deps/pjsip
prune deps/pjproject-*
exclude deps/2.10.tar.gz deps/2.12.tar.gz
recursive-include sipsimple *.pxi
recursive-include sipsimple *.pxd

